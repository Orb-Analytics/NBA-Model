# Ignore service account credentials
service_account.json

# Ignore Python cache and temp files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore Jupyter notebook checkpoints
.ipynb_checkpoints/

# Ignore data outputs (optional, comment out if you want to track them)
data/*.csv

# Ignore environment and system files
.env
*.env
.DS_Store

# --- Allow master training set CSVs ---
!data/NBA Training Set 25-26.csv
!data/training_set_*.csv
!data/training_set_latest.csv
!data/novig-odds/*.csv

