# Ignore Python cache
__pycache__/
*.pyc

# Ignore Jupyter checkpoints
.ipynb_checkpoints/

# Ignore virtual environment folders
venv/
.env/

# Ignore service account credentials
service_account.json

# Ignore system files
.DS_Store

# Ignore temp CSVs and caches
*.tmp
temp/
cache/
*.log

# ✅ Do NOT ignore your data folder
